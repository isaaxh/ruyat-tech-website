---
// Hidden until scripts/cookie-banner.ts confirms no choice is stored, so returning visitors never see it flash.
import Button from '../ui/Button.astro';
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}
const { cookie } = Astro.props.t;
---

<div class="cookie" role="region" aria-label={cookie.label} hidden>
  <p>{cookie.text}</p>
  <div class="cookie-actions">
    <Button variant="secondary" size="sm" data-choice="accepted">{cookie.accept}</Button>
    <button class="plain" type="button" data-choice="declined">{cookie.decline}</button>
  </div>
</div>

<script>
  import { initCookieBanner } from '../../scripts/cookie-banner';
  initCookieBanner();
</script>
