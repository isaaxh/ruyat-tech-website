---
// Floating gold WhatsApp button, fixed to the bottom corner opposite the cookie banner.
import Icon from '../icons/Icon.astro';
import { FLOATING_WHATSAPP_NUMBER } from '../../config';
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<a class="wa-fab" href={`https://wa.me/${FLOATING_WHATSAPP_NUMBER}`} target="_blank" rel="noopener" aria-label={t.floatingWhatsapp} title={t.floatingWhatsapp}>
  <Icon name="whatsapp" size={30} />
</a>
