---
// One service card. The link scrolls to the form and preselects this service (scripts/contact-form.ts).
// The cursor lights the card's edges only; the card itself does not move.
import Edge from '../../ui/Edge.astro';
import CardHex from '../../ui/CardHex.astro';
import Icon from '../../icons/Icon.astro';
import Arrow from '../../icons/Arrow.astro';
import ServiceArt from './ServiceArt.astro';

interface Props {
  kind: 'mobile' | 'webapp' | 'website' | 'automation';
  wide?: boolean;
  title: string;
  promise: string;
  desc: string;
  link: string;
  /** Value of the matching option in the contact form's service select. */
  service: string;
}
const { kind, wide = false, title, promise, desc, link, service } = Astro.props;
---

<article class:list={['svc-card', { 'svc-wide': wide }]}>
  <Edge />
  <CardHex />
  <ServiceArt kind={kind} />
  <div class="svc-meta"><span class="svc-hex"><Icon name={kind} /></span><h3>{title}</h3></div>
  <p class="svc-promise">{promise}</p>
  <p class="svc-desc">{desc}</p>
  <a class="svc-link" href="#contact" data-service={service}><span>{link}</span><Arrow size={18} /></a>
</article>
