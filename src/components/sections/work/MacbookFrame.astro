---
// Pure-CSS MacBook frame around a website screenshot; the whole frame links to the live site.
import { Image } from 'astro:assets';
import Edge from '../../ui/Edge.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  label: string;
  src: ImageMetadata;
  alt: string;
}
const { href, label, src, alt } = Astro.props;
---

<a class="ph-img case-shot" href={href} target="_blank" rel="noopener" aria-label={label}
  ><Edge /><span class="mbp"
    ><span class="mbp-lid"
      ><span class="mbp-cam" aria-hidden="true"></span><span class="mbp-screen"
        ><Image src={src} alt={alt} width={1200} height={652} widths={[480, 960, 1200]} sizes="(max-width: 640px) 80vw, 480px" loading="lazy" decoding="async" /></span
      ></span
    ><span class="mbp-base" aria-hidden="true"><span class="mbp-notch"></span></span></span
  ></a
>
