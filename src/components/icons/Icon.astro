---
import { ICONS, type IconName } from './paths';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** When set, the icon is announced (role="img" + <title>); otherwise it is hidden from assistive tech. */
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;
const body = (label ? `<title>${label}</title>` : '') + ICONS[name];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={body}
/>
