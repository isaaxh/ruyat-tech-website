---
// "Powered by Ruyat Al Enjaz" pill: with the hex mark, or with a glowing dot.
import Mark from '../brand/Mark.astro';

interface Props {
  variant?: 'mark' | 'dot';
}
const { variant = 'mark' } = Astro.props;
---

{
  variant === 'dot' ? (
    <span class="badge badge--dot">
      <span class="badge-dot" aria-hidden="true" />
      <slot />
    </span>
  ) : (
    <span class="badge">
      <Mark variant="badge" />
      <slot />
    </span>
  )
}
